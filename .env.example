# Copy to .env and fill in. Never commit .env. Throwaway testnet keys only.
MONAD_RPC_URL=
AGENCY_A_PRIVATE_KEY=
AGENCY_B_PRIVATE_KEY=
# Optional override. Normally empty: the client reads the address from sim/lantern_deployment.json
# (written by contracts/deploy.sh). Set it only to point at another deployment, e.g. a local anvil.
LANTERN_CONTRACT_ADDRESS=
# Optional. A Kubo IPFS node for evidence (untested path); without it evidence is local only.
IPFS_API=
# Optional. An IPFS gateway to fetch evidence by CID (sim/evidence.py).
IPFS_GATEWAY=
# Optional. LanternSurvey results contract (sim/survey.py); normally read from sim/survey_deployment.json.
SURVEY_CONTRACT_ADDRESS=
# Optional. Where built data and runs live (sim/terrain.py). Set it to ./lantern_data, the
# committed copy, to run without building terrain. Default: C:\Monad-Hackathon-Project\data
# if it exists, else ./data.
LANTERN_DATA=
# Optional. Where sim/resources.py writes its outputs. Default ./data.
LANTERN_OUT=
# Optional. Path to another rover.py to plan with (sim/planner_link.py).
LANTERN_PLANNER=
